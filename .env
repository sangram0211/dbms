# =====================================================================
# Database Configuration
# =====================================================================
# Engine selection:
# - 'auto'   : Tries MySQL first; if unavailable, automatically falls back to SQLite
# - 'mysql'  : Enforces MySQL connection (requires running MySQL server)
# - 'sqlite' : Enforces local SQLite storage (expense_tracker.db)
DB_ENGINE=auto

# MySQL Server Credentials (standard XAMPP / MAMP / Localhost defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Sangram@0210
DB_NAME=expense_tracker_db

# Flask Application Settings
SECRET_KEY=dbms_personal_expense_tracker_secret_key_2026
FLASK_ENV=development
PORT=5050
